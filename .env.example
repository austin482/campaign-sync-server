# Lark Metrics Proxy — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control!

# Lark / Feishu Custom App credentials
# Get these from: https://open.larksuite.com/ (or https://open.feishu.cn)
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Which Lark domain to use
# Use "open.larksuite.com" for Lark (international)
# Use "open.feishu.cn" for Feishu (China)
LARK_DOMAIN=open.larksuite.com

# Port for this proxy server
PORT=3000

# Allowed extension origins (comma-separated, leave * for any)
# For production, set this to your Chrome extension ID origin:
# e.g. chrome-extension://abcdefghijklmnopqrstuvwxyz123456
ALLOWED_ORIGINS=*

# Facebook Graph API (optional — for reading Facebook post metrics)
# Get your token from: https://developers.facebook.com/tools/explorer/
# Select your Page → Generate Token → copy the Page Access Token
# For a long-lived token, use: https://developers.facebook.com/tools/debug/accesstoken/
FACEBOOK_ACCESS_TOKEN=
